{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingshan.example/schemas/generation_contract.schema.json",
  "title": "Qingshan Writer Generation Contract",
  "type": "object",
  "required": ["schema", "episode", "visual_culture_contract", "character_entities", "scene_states", "shots", "audio_contract"],
  "properties": {
    "schema": {"const": "qingshan.generation_contract.v3"},
    "episode": {"pattern": "^E[0-9]+$"},
    "pacing_policy": {
      "enum": ["SHORT_DRAMA_PACING_V1", "OFF"],
      "description": "默认 SHORT_DRAMA_PACING_V1（2026-11-22 起所有合同缺省即生效；JA-01 E07 缺这个键时只记录、从不改稿）：S1 免费测量剧本节奏（lines/nalu/runtime/tools/script_pacing_check.py）；不合格时编剧自己改稿，最多两轮后自动放行。只有明确写 OFF 才关闭；已过付费阶段、靠默认的在制集只记录。"
    },
    "pacing_scene_plan": {
      "type": "array",
      "description": "兼容别名：同 pacing.scene_plan（检查会合并两者）；新合同写在 pacing.scene_plan。",
      "items": {"type": "object", "required": ["scene_id"]}
    },
    "adaptation_plan": {
      "type": "object",
      "description": "可选（SHORT_DRAMA_PACING_V1）：本集改编预算按剧情事件算，不按章节算。source_chapters = 本集用到的原著章节号；plot_events = 本集覆盖的剧情事件（≥ 所需转折数）；cut = 删掉/合并/压缩的内容。S1 记入 series/SOURCE_COVERAGE.json。",
      "properties": {
        "source_chapters": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "plot_events": {"type": "array"},
        "cut": {"type": "array"}
      },
      "additionalProperties": true
    },
    "camera_grammar_policy": {
      "enum": ["CAMERA_GRAMMAR_V1", "LEGACY_FORCED_MOTION"],
      "description": "CAMERA_GRAMMAR_V1 (configs/CAMERA_GRAMMAR_V1.json): motivated camera motion and film grammar as writer guidance (no blocking check). storyclaw finalize stamps it when absent."
    },
    "visual_culture_contract": {
      "type": "object",
      "required": ["schema", "status", "profile_id", "decision_owner", "decision_basis", "source_ref"],
      "properties": {"decision_owner": {"const": "WRITER_DIRECTOR"}}
    },
    "character_entities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["character_id", "canonical_name", "aliases"],
        "properties": {
          "character_id": {"type": "string", "minLength": 1},
          "canonical_name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "scene_states": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {"type": "string"},
          "location_id": {"type": "string"},
          "costume_overrides": {
            "type": "object",
            "description": "B5：按场景继承的服装状态显式变更 {character_id: {remove: [], add: []}}；室外→室内摘帽必须声明",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "remove": {"type": "array", "items": {"type": "string"}},
                "add": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {"type": "string"},
          "scene_id": {"type": "string"},
          "target_seconds": {"type": "number"},
          "group_counts": {
            "type": "object",
            "description": "B1：{group_id: {count, count_change_note?}}；同 group 跨镜 count 变化必须带 count_change_note",
            "additionalProperties": {
              "type": "object",
              "required": ["count"],
              "properties": {
                "count": {"type": "integer", "minimum": 0},
                "count_change_note": {"type": "string"}
              }
            }
          },
          "prompt_spec": {
            "type": "object",
            "properties": {
              "cast": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "character": {"type": "string"},
                    "character_id": {"type": "string"},
                    "life_state": {
                      "enum": ["alive", "injured", "unconscious", "dead"],
                      "description": "B1：每镜每角色生命状态；dead 之后不得回到非 dead"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "audio_contract": {
      "type": "object",
      "properties": {
        "dialogue_units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "shot_id": {"type": "string"},
              "speaker_id": {"type": "string"},
              "listener_id": {"type": "string"},
              "text": {"type": "string"},
              "emotion": {
                "type": "string",
                "description": "C2：每句情绪，映射为演绎条款（响度/语速/气息），生成后 emotion_dynamics 检测。推荐 calm / plead / threat / mock / joy / fear；单字中文情绪（急、冷、惊…）与其它英文词（tense、happy…）同样有效——S1 只校验它是字符串"
              }
            }
          }
        }
      }
    },
    "protagonist_ids": {
      "type": "array", "items": {"type": "string"},
      "description": "可选。主角 character_id 列表；未声明时取 character_entities[0]。entity_introductions 校验对主角豁免"
    },
    "pacing": {
      "type": "object",
      "description": "可选。hook 与 dialogue_density 由 tools/script_structure_contract_gate.py 读取（A1/A5）",
      "properties": {
        "hook": {
          "type": "object",
          "required": ["type", "at_seconds"],
          "properties": {
            "type": {"enum": ["dialogue", "shock", "question"]},
            "at_seconds": {"type": "number", "minimum": 0, "maximum": 5},
            "line_or_shot_id": {"type": "string", "minLength": 1, "description": "type == shock 时必填（钩子镜 id）；dialogue / question 可省略（旧写法 shot_id 同样接受）"},
            "shot_id": {"type": "string"}
          }
        },
        "beat_sheet": {
          "type": "array",
          "description": "可选（SHORT_DRAMA_PACING_V1）：爽点/转折表。每行 {shot_id, type, setup_shot_id?, intensity?}；type ∈ HUMILIATION_PAYBACK | IDENTITY_REVEAL | POWER_SHIFT | SECRET_REVEALED | THREAT_ESCALATION | CONFRONTATION | ROMANTIC_SPIKE | REVERSAL | DISCOVERY",
          "items": {"type": "object", "required": ["type"]}
        },
        "scene_plan": {
          "type": "array",
          "description": "SHORT_DRAMA_PACING_V1（默认）：每场 {scene_id, objective, conflict, physical_action}；写在 pacing 里（顶层 pacing_scene_plan 也认）",
          "items": {"type": "object", "required": ["scene_id"], "properties": {"scene_id": {"type": "string"}, "objective": {"type": "string"}, "conflict": {"type": "string"}, "physical_action": {"type": "string"}}}
        },
        "cliffhanger": {
          "type": "object",
          "description": "可选（SHORT_DRAMA_PACING_V1）：结尾悬念 {shot_id（最后一镜或最后 8 秒内）, open_question}",
          "properties": {"shot_id": {"type": "string"}, "open_question": {"type": "string"}}
        },
        "dialogue_density": {
          "type": "object",
          "properties": {
            "max_silent_run_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 15},
            "max_silent_run_action_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 25},
            "min_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.35},
            "verdict": {"enum": ["FAIL", "WARN"], "default": "FAIL"}
          }
        }
      },
      "additionalProperties": true
    },
    "antagonist_groups": {
      "type": "array",
      "description": "A3：character_entities[].role == antagonist 或分镜出现伏击/埋伏/截时必填；motive_setup.ref 必须早于 first_action_shot_id",
      "items": {
        "type": "object",
        "required": ["group_id", "first_action_shot_id", "motive_setup"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "member_ids": {"type": "array", "items": {"type": "string"}, "description": "成员 character_id（旧写法 character_ids 同样接受）"},
          "character_ids": {"type": "array", "items": {"type": "string"}},
          "first_action_shot_id": {"type": "string", "pattern": "^E\\d+-S\\d+-\\d+$"},
          "motive_setup": {
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": {"enum": ["line", "shot", "recap"]},
              "ref": {
                "oneOf": [
                  {"type": "string", "pattern": "^E\\d+-S\\d+-\\d+$"},
                  {
                    "type": "object",
                    "required": ["episode", "shot_id", "recap_shot_id"],
                    "properties": {
                      "episode": {"type": "string", "pattern": "^E[0-9]+$"},
                      "shot_id": {"type": "string"},
                      "recap_shot_id": {"type": "string", "pattern": "^E\\d+-S\\d+-\\d+$"}
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "entity_introductions": {
      "type": "array",
      "description": "B3′：非主角人物与钩子窗口（5 s）后首次出现的非人物实体必须声明 setup 或 payoff",
      "items": {
        "type": "object",
        "required": ["entity_id"],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "first_shot_id": {"type": "string", "pattern": "^E\\d+-S\\d+-\\d+$"},
          "setup": {
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": {"enum": ["line", "shot", "recap", "prior_episode"]},
              "ref": {"type": "string", "minLength": 1}
            }
          },
          "payoff_shot_id": {"type": "string", "pattern": "^E\\d+-S\\d+-\\d+$"}
        }
      }
    },
    "ambush_contracts": {
      "type": "array",
      "description": "B4：分镜出现伏击/埋伏/藏身时必填；reveal_shot_id 之前 who_approaches 不得进入 hide_place_id",
      "items": {
        "type": "object",
        "required": ["who_hides", "who_approaches", "hide_place_id", "reveal_shot_id"],
        "properties": {
          "who_hides": {"type": "array", "items": {"type": "string"}},
          "who_approaches": {"type": "array", "items": {"type": "string"}},
          "hide_place_id": {"type": "string", "minLength": 1},
          "reveal_shot_id": {"type": "string", "pattern": "^E\\d+-S\\d+-\\d+$"}
        }
      }
    },
    "props": {
      "type": "object",
      "properties": {
        "reference_cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entity_id": {"type": "string"},
              "name": {"type": "string"},
              "acquired": {
                "type": "object",
                "required": ["episode", "shot_id"],
                "properties": {
                  "episode": {"type": "string", "pattern": "^E[0-9]+$"},
                  "shot_id": {"type": "string", "minLength": 1}
                },
                "description": "A4：道具获取镜（可跨集）；出现在 payoff_shot_ids 或台词里被指代的道具必填"
              },
              "payoff_shot_ids": {"type": "array", "items": {"type": "string", "pattern": "^E\\d+-S\\d+-\\d+$"}},
              "recap_shot_id": {
                "type": "string",
                "description": "A4：acquired.episode ≠ 本集时必填，本集可见建立镜，须早于首个 payoff ≥10 s"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "non_character_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {"type": "string"},
          "name": {"type": "string"},
          "first_shot": {"type": "string"},
          "kind": {"enum": ["PROP", "SET", "CREATURE", "ANIMAL", "VEHICLE", "OTHER"]},
          "creature_card": {
            "type": "object",
            "required": ["locomotion", "eye_color", "silhouette_ref"],
            "properties": {
              "locomotion": {"enum": ["biped", "quadruped", "slithering", "flying"]},
              "eye_color": {"type": "string", "minLength": 1},
              "silhouette_ref": {"type": "string", "minLength": 1}
            },
            "description": "B2：kind == CREATURE 时必填；所有出现该 creature 的镜的动作文本步态词必须与 locomotion 一致"
          }
        }
      }
    }
  }
}
