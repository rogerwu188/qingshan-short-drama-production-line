# TEMPLATE ONLY — not a real configuration. No quotes, export, inline comments or shell code.
# Copy privately to source_config.env and fill the five fields below.
# The actual source_config.env and host public key must never enter the public repository.
SOURCE_USER=
SOURCE_HOME=
SOURCE_HOST=
SOURCE_HOST_KEY_FILE=source_host.pub
SOURCE_HOST_KEY_SHA256=

# Relative paths under SOURCE_HOME; no leading/trailing slash, no .. components.
# Number roots consecutively, at most 32. KIND=dir/file; OPTIONAL=0/1.
ROOT_1_REL=Documents/production-workspace
ROOT_1_KIND=dir
ROOT_1_OPTIONAL=0
ROOT_2_REL=production-runtime
ROOT_2_KIND=dir
ROOT_2_OPTIONAL=0
ROOT_3_REL=handoff/RECOVERY.md
ROOT_3_KIND=file
ROOT_3_OPTIONAL=0
ROOT_4_REL=.cache/public-models
ROOT_4_KIND=dir
ROOT_4_OPTIONAL=1
