{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qingshan.collective.adoption_receipt.v1",
  "title": "AdoptionReceipt",
  "type": "object",
  "required": [
    "receipt_id",
    "tenant_id",
    "line_id",
    "device_id",
    "run_id",
    "rule_id",
    "rule_version",
    "bundle_digest",
    "stage",
    "state",
    "entrypoint"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$"
    },
    "line_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$"
    },
    "rule_version": {
      "type": "integer"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "SELECTED",
        "APPLIED",
        "VERIFIED",
        "OUTCOME_OBSERVED",
        "NOT_APPLICABLE",
        "DEFERRED",
        "FAILED"
      ]
    },
    "entrypoint": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$"
      }
    },
    "source_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiled_output_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "change_evidence": {},
    "evidence_scope": {
      "type": "string",
      "enum": [
        "SOURCE_CONTRACT",
        "COMPILED_REQUEST",
        "PROVIDER_REQUEST",
        "GENERATED_MEDIA",
        "FINAL_FILM"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "test_name": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "assertion": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "DEFECT_ABSENT",
            "DEFECT_RECURRED",
            "ACCEPTED_IMPERFECTION",
            "NO_CHANGE_OBSERVED"
          ]
        },
        "media_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "description": "The four real inputs behind the receipt (contracts.validate_case_provenance): fact, cause, rule_source, verification. Optional; validated strictly when present.",
      "type": "object",
      "required": ["fact", "cause", "rule_source", "verification"],
      "properties": {
        "fact": {
          "type": "object",
          "required": ["statement", "artefact", "artefact_sha256", "measured"],
          "properties": {
            "statement": {"type": "string", "minLength": 1},
            "artefact": {"$ref": "#/$defs/locator"},
            "artefact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "measured": {}
          }
        },
        "cause": {
          "type": "object",
          "required": ["statement", "evidence"],
          "properties": {
            "statement": {"type": "string", "minLength": 1},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["statement", "artefact", "artefact_sha256"],
                "properties": {
                  "statement": {"type": "string", "minLength": 1},
                  "artefact": {"$ref": "#/$defs/locator"},
                  "artefact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            }
          }
        },
        "rule_source": {
          "type": "object",
          "required": ["clause", "file", "line"],
          "properties": {
            "clause": {"type": "string", "minLength": 1},
            "file": {"type": "string", "minLength": 1},
            "line": {"type": "integer", "minimum": 1}
          }
        },
        "verification": {
          "type": "object",
          "required": ["measurement", "before", "after"],
          "properties": {
            "measurement": {"type": "string", "minLength": 1},
            "before": {"$ref": "#/$defs/measured_side"},
            "after": {"$ref": "#/$defs/measured_side"},
            "restores_earlier_output": {"type": "boolean"}
          }
        }
      }
    },
    "real_run_consumption": {
      "description": "Whether a REAL later build consumed the rule. Stated, never inferred.",
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["CONSUMED_BY_REAL_RUN", "CONSUMED_BY_REPLAY_ONLY", "NOT_YET_CONSUMED_BY_REAL_RUN"]
        },
        "reason": {"type": "string"},
        "consumer_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["run_id", "output_sha256", "clause_present", "after_rule_recorded"],
            "properties": {
              "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$"},
              "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "clause_present": {"const": true},
              "after_rule_recorded": {"const": true}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "required": ["root", "path"],
      "properties": {
        "root": {"type": "string", "enum": ["ENGINE", "WORKFLOW", "RUNTIME"]},
        "path": {"type": "string", "minLength": 1, "not": {"pattern": "^/"}}
      }
    },
    "measured_side": {
      "type": "object",
      "required": ["value", "artefact", "artefact_sha256"],
      "properties": {
        "value": {},
        "artefact": {"$ref": "#/$defs/locator"},
        "artefact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
