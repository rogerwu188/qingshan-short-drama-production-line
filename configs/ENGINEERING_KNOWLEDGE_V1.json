  "rules": [
    {
      "id": "K001",
      "stage": "TRANSACTIONS",
      "rule": "恢复事务后再提交；绑定 ID 复用，未知响应隔离。",
      "lesson": "曾因断流无法判断是否扣费；换提示词不是重复提交同一逻辑任务的许可。",
      "recovery": "确认 ledger 和 provider 状态，不盲目 POST。",
      "implementation": [
        "tools/giggle_api_client.py"
      ],
      "status": "REFERENCE_IMPLEMENTATION",
      "owner": "DEPLOYMENT_MAINTAINER",
      "authority": "SANITIZED_PROJECT_RETROSPECTIVE",
      "decision_record": "docs/decisions/DECISION_RECORDS.md",
      "regression": "tools/tests/test_knowledge_registry.py",
      "runtime_gate_added": false
    },
    {
      "id": "K002",
      "stage": "QA",
      "rule": "整批关键帧和视频提示词先生成、先 QA，再并发执行可独立任务。",
      "lesson": "逐条编译、逐条等待曾导致低吞吐。",
      "recovery": "保留依赖图、全批次哈希准入；参考绑定变化走已有精确物化检查。",
      "implementation": [
        "tools/episode_prompt_batch_gate.py"
      ],
      "status": "REFERENCE_IMPLEMENTATION",
      "owner": "DEPLOYMENT_MAINTAINER",
      "authority": "SANITIZED_PROJECT_RETROSPECTIVE",
      "decision_record": "docs/decisions/DECISION_RECORDS.md",
      "regression": "tools/tests/test_knowledge_registry.py",
      "runtime_gate_added": false
    },
    {
      "id": "K003",
      "stage": "SCHEDULING",
      "rule": "不能凭空固定三个并发；按供应商限制、额度、锁和任务依赖调度。",
      "lesson": "提高并发不意味着跨越真实尾帧依赖。",
      "recovery": "先并发独立任务；有依赖的任务等待所需媒体，不伪造依赖完成。",
      "implementation": [],
      "status": "GUIDANCE_ONLY",
      "owner": "DEPLOYMENT_MAINTAINER",
      "authority": "SANITIZED_PROJECT_RETROSPECTIVE",
