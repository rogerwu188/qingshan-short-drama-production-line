{
  "schema": "qingshan.platform_release_automation_policy.v1",
  "status": "ACTIVE",
  "scope": "All episodes except explicitly excluded episodes",
  "policy": {
    "additional_owner_content_review_before_release_required": false,
    "publish_immediately_after_registered_release_qa_pass": true,
    "ordinary_release_approval_is_persistent": true,
    "do_not_request_episode_by_episode_content_approval": true,
    "platform_order": [
      "YOUTUBE",
      "DOUYIN"
    ],
    "inspect_existing_platform_state_before_upload": true,
    "duplicate_upload_or_submission_forbidden": true,
    "prepare_upload_metadata_checks_and_duplicate_scan_before_confirmation": true,
    "browser_action_confirmation_is_not_a_content_review_gate": true,
    "browser_action_confirmation_strategy": "ONE_COMBINED_CONFIRMATION_FOR_YOUTUBE_AND_DOUYIN_AT_FINAL_COMMIT",
    "do_not_request_a_second_confirmation_for_the_same_release_batch": true,
    "persist_terminal_receipt_before_starting_next_platform_or_episode": true,
    "auto_start_next_episode_after_both_terminal_publication_receipts": true,
    "preferred_browser": "CODEX_IN_APP_BROWSER",
    "in_app_browser_maximum_attempts": 3,
    "fallback_after_third_in_app_failure": "CONNECTED_EXTERNAL_BROWSER"
  },
  "permanent_exclusions": [
    {
      "episode": "E40",
      "rule": "PERMANENTLY_PRIVATE_ABANDONED_NEVER_REPUBLISH"
    }
  ]
}
