# This repository is a code-only mirror of the local production workspace.
# Runtime media, QA evidence, transactions, credentials, and operator logs stay local.
/*
!/.gitignore
!/README.md
!/tools/
!/agent_factory/
!/configs/
/configs/*
!/configs/GATE_REGISTRY_v3_20260716.json
!/codex_docs/
/codex_docs/*
!/codex_docs/美剧叙事节奏标准_v2_结构层_20260818.md
!/workflow/
/workflow/*
!/workflow/claude_writer_agent/
/workflow/claude_writer_agent/*
!/workflow/claude_writer_agent/宪章_ClaudeWriterAgent_v1.md
!/workflow/claude_writer_agent/青山编剧Claude_云端可移植宪章_v1.md
!/workflow/claude_writer_agent/WRITER_TASK_E41_E82_RESTRUCTURE.md

# Portable agent installers/templates are code, never runtime state.
!/agent_factory/claude_writer/
!/agent_factory/claude_writer/**

# Generated/runtime material inside the tracked code trees.
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/*.bak
**/*.bak_*
**/*.tmp
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*token*.json
