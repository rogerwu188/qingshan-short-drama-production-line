# Copy to .env in your private execution workspace. Never commit real values.
GIGGLE_API_KEY=
GIGGLE_API_BASE=https://giggle.pro
QINGSHAN_ENGINE_ROOT=

# Optional media binary overrides. Otherwise PATH is used.
FFMPEG=
FFPROBE=

# Required only when canonical speaker/voice binding is used.
QINGSHAN_VOICE_REGISTRY=

# Optional YouTube Data API credentials. Interactive browser release can be
# used instead; Douyin Creator Center currently uses an interactive login.
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_FILE=

# Optional S3/StoryClaw archive and collaboration integration.
S3_RELAY_BUCKET=
S3_RELAY_ENDPOINT=
S3_RELAY_PREFIX=
STORYCLAW_BRIDGE_BASE_URL=
STORYCLAW_BRIDGE_TOKEN=
